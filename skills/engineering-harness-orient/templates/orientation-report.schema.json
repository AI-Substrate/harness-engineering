{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/engineering-harness-orient/orientation-report.schema.json",
  "title": "Engineering harness orientation report",
  "description": "Core v0.1 JSON contract for engineering-harness-orient reports.",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "repo",
    "run",
    "verdict",
    "harness_surfaces",
    "project_detection",
    "command_tiers",
    "services",
    "environment",
    "app_surfaces",
    "auth",
    "state_and_fixtures",
    "observability",
    "proof_model",
    "gaps",
    "codebase_affordance_recommendations",
    "human_questions",
    "recommended_next_actions",
    "proposed_patches"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "engineering-harness-orientation.v0.1"
    },
    "generated_at": { "type": "string" },
    "repo": {
      "type": "object",
      "required": ["root", "name", "branch", "commit", "is_monorepo", "package_roots"],
      "additionalProperties": true,
      "properties": {
        "root": { "type": "string" },
        "name": { "type": "string" },
        "branch": { "type": "string" },
        "commit": { "type": "string" },
        "is_monorepo": { "type": "boolean" },
        "package_roots": { "type": "array", "items": { "type": "string" } }
      }
    },
    "run": {
      "type": "object",
      "required": ["mode", "probes_executed", "commands_executed", "commands_skipped", "safety_notes"],
      "additionalProperties": true,
      "properties": {
        "mode": { "type": "string", "enum": ["read_only", "safe_probe", "clean_start"] },
        "probes_executed": { "type": "boolean" },
        "commands_executed": { "type": "array", "items": { "type": "string" } },
        "commands_skipped": { "type": "array", "items": { "type": "string" } },
        "safety_notes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "verdict": {
      "type": "object",
      "required": ["status", "harnessability_level", "score", "confidence", "summary"],
      "additionalProperties": true,
      "properties": {
        "status": { "type": "string", "enum": ["ready", "partial", "blocked", "unknown"] },
        "harnessability_level": { "type": "string", "enum": ["H0", "H1", "H2", "H3", "H4", "H5"] },
        "score": { "type": "integer", "minimum": 0, "maximum": 100 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "summary": { "type": "string" }
      }
    },
    "harness_surfaces": { "$ref": "#/$defs/objectMap" },
    "project_detection": { "$ref": "#/$defs/objectMap" },
    "command_tiers": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": { "$ref": "#/$defs/commandCandidate" }
      }
    },
    "services": { "$ref": "#/$defs/objectMap" },
    "environment": { "$ref": "#/$defs/objectMap" },
    "app_surfaces": { "$ref": "#/$defs/objectMap" },
    "auth": { "$ref": "#/$defs/objectMap" },
    "state_and_fixtures": { "$ref": "#/$defs/objectMap" },
    "observability": { "$ref": "#/$defs/objectMap" },
    "proof_model": {
      "type": "object",
      "required": ["highest_detected_proof_level", "target_initial_proof_level", "evidence_paths", "rerun_command"],
      "additionalProperties": true,
      "properties": {
        "highest_detected_proof_level": { "type": "string" },
        "target_initial_proof_level": { "type": "string" },
        "evidence_paths": { "type": "array", "items": { "type": "string" } },
        "rerun_command": { "type": ["string", "null"] }
      }
    },
    "gaps": {
      "type": "array",
      "items": { "$ref": "#/$defs/gap" }
    },
    "codebase_affordance_recommendations": {
      "type": "array",
      "items": { "$ref": "#/$defs/codebaseAffordanceRecommendation" }
    },
    "human_questions": {
      "type": "array",
      "items": { "$ref": "#/$defs/humanQuestion" }
    },
    "recommended_next_actions": { "$ref": "#/$defs/objectMap" },
    "proposed_patches": {
      "type": "array",
      "items": { "$ref": "#/$defs/proposedPatch" }
    }
  },
  "$defs": {
    "objectMap": {
      "type": "object",
      "additionalProperties": true
    },
    "commandCandidate": {
      "type": "object",
      "required": ["tier", "command", "source", "status", "confidence", "executed"],
      "additionalProperties": true,
      "properties": {
        "tier": { "type": "string" },
        "command": { "type": "string" },
        "source": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["candidate_unverified", "configured_unverified", "verified", "not_applicable", "unknown"]
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "executed": { "type": "boolean" }
      }
    },
    "gap": {
      "type": "object",
      "required": ["id", "subsystem", "loop_stage", "target_layer", "encoding_type", "severity", "status", "finding", "recommended_encoding", "provenance", "confidence"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string" },
        "subsystem": { "type": "string" },
        "loop_stage": { "type": "string" },
        "target_layer": { "type": "string" },
        "encoding_type": { "type": "string" },
        "severity": { "type": "string", "enum": ["blocker", "high", "medium", "low", "info"] },
        "status": { "type": "string" },
        "finding": { "type": "string" },
        "recommended_encoding": { "type": "string" },
        "provenance": { "type": "string", "enum": ["evidence", "inference", "human_supplied", "unknown"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "codebaseAffordanceRecommendation": {
      "type": "object",
      "required": ["id", "title", "category", "target_layer", "harness_loop_stage", "problem", "recommended_change", "environment_scope", "must_not_apply_in", "risk", "requires_human_review", "status"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "target_layer": { "type": "string", "const": "product_code" },
        "harness_loop_stage": { "type": "string" },
        "problem": { "type": "string" },
        "recommended_change": { "type": "string" },
        "environment_scope": { "type": "array", "items": { "type": "string" } },
        "must_not_apply_in": { "type": "array", "items": { "type": "string" } },
        "risk": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
        "requires_human_review": { "type": "boolean" },
        "status": { "type": "string", "const": "proposed" }
      }
    },
    "humanQuestion": {
      "type": "object",
      "required": ["id", "question", "reason", "answer_type"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string" },
        "question": { "type": "string" },
        "reason": { "type": "string" },
        "answer_type": { "type": "string" }
      }
    },
    "proposedPatch": {
      "type": "object",
      "required": ["id", "path", "target_layer", "risk", "type", "summary", "requires_human_review"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string" },
        "path": { "type": "string" },
        "target_layer": { "type": "string" },
        "risk": { "type": "string" },
        "type": { "type": "string" },
        "summary": { "type": "string" },
        "requires_human_review": { "type": "boolean" }
      }
    }
  }
}

