// markdownlint-cli2 config for `harness markdown-lint` (plan 029).
//
// RULES ONLY. The authored-docs SCOPE is owned in code by the single source of
// truth `.harness/extensions/markdown-lint/lib/scope.ts` (the verb passes an
// explicit, pre-filtered file list), so `globs`/`ignores` here are belt-and-
// suspenders for anyone running `markdownlint-cli2` directly — NOT the scope
// contract. Never widen scope to dodge a finding (plan § Scope contract).
//
// Disabled rules are deliberate conflicts with this repo's established authored-
// doc conventions (each with a one-line rationale). New rules are never added;
// disable a rule here only to record a convention, and re-enable per rule as the
// docs are cleaned. Warn-launch: residual findings land as degraded/exit 0.
{
  "config": {
    "default": true,

    // — High-volume conventions the repo authored docs deliberately don't follow —
    "MD013": false, // line-length: authored prose is intentionally long / unwrapped
    "MD060": false, // table-column-style: repo uses compact pipe tables on purpose
    "MD055": false, // table-pipe-style: same compact-table convention
    "MD033": false, // no-inline-html: docs use inline HTML (<details>, <br>, comments)
    "MD034": false, // no-bare-urls: bare URLs appear by choice in places
    "MD040": false, // fenced-code-language: bare ``` fences are used for terminal/evidence output
    "MD041": false, // first-line-h1: doc fragments/partials intentionally don't open with H1
    "MD056": false, // table-column-count: misfires on skill TEMPLATE placeholder rows ({{VAR}} as a 1-cell row)

    // MD024 duplicate-headings: allow repeats under DIFFERENT parents (changelogs
    // repeat "### Features" per version); still catches true sibling duplicates.
    "MD024": { "siblings_only": true },

    // — Whitespace-hygiene backlog: widely violated across authored docs; not mass-
    //   editing the shared working tree now. Re-enable per rule once docs are cleaned. —
    "MD012": false, // no-multiple-blanks
    "MD022": false, // blanks-around-headings
    "MD031": false, // blanks-around-fences
    "MD032": false, // blanks-around-lists
    "MD028": false, // no-blanks-blockquote
    "MD009": false, // no-trailing-spaces
    "MD047": false, // single-trailing-newline
    "MD036": false, // no-emphasis-as-heading
    "MD038": false  // no-space-in-code-span
  },

  // Documentation of the same scope the verb enforces in code (not load-bearing here).
  "ignores": [
    "docs/plans/**",
    ".harness/**",
    "agents/**",
    "docs/retros/**",
    "harness/cli/test/**",
    "**/reviews/**",
    "node_modules/**",
    "dist/**",
    "coverage/**",
    "scratch/**",
    "**/the-flow.md",
    "**/*.fltplan.md",
    "**/tasks/**"
  ]
}
