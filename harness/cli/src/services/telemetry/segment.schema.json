{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ai-substrate.dev/schemas/telemetry/segment-2.1.json",
  "title": "Harness telemetry segment (counts-only)",
  "description": "Normalized, counts-only per-session telemetry record (plan 034). The load-bearing cross-tool/cross-repo contract. NO content fields ever — only allowlisted counts and identifiers; file paths are repo-relative. Capability fields are nullable (null when unimplemented, never estimated). Kept key-set-equal to SEGMENT_FIELD_KEYS by segment-schema.test.ts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "command",
    "harness",
    "harness_version",
    "harness_session_id",
    "timecode",
    "window",
    "branch",
    "tokens",
    "effort",
    "event_stream",
    "rollup"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "2.1" },
    "command": { "type": "string" },
    "harness": { "type": "string" },
    "harness_version": { "type": "string" },
    "harness_session_id": { "type": "string" },
    "timecode": { "type": "string" },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["since", "from", "to"],
      "properties": {
        "since": { "enum": ["session-start", "last-command"] },
        "from": { "type": "integer" },
        "to": { "type": "integer" }
      }
    },
    "branch": { "type": ["string", "null"] },
    "tokens": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": [
        "input",
        "output",
        "cache_create",
        "cache_read",
        "total",
        "subagent_tokens",
        "grand_total"
      ],
      "properties": {
        "input": { "type": "integer" },
        "output": { "type": "integer" },
        "cache_create": { "type": "integer" },
        "cache_read": { "type": "integer" },
        "total": { "type": "integer" },
        "subagent_tokens": { "type": "integer" },
        "grand_total": { "type": "integer" }
      }
    },
    "models": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["turns", "output_tokens"],
        "properties": {
          "turns": { "type": "integer" },
          "output_tokens": { "type": "integer" }
        }
      }
    },
    "effort": { "type": ["string", "null"] },
    "skills": {
      "type": "object",
      "additionalProperties": { "type": "integer" }
    },
    "tools": {
      "type": "object",
      "additionalProperties": { "type": "integer" }
    },
    "user_prompts": { "type": "array", "items": { "type": "integer" } },
    "subagents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["count"],
        "properties": {
          "type": { "type": "string" },
          "agent_name": { "type": "string" },
          "model": { "type": "string" },
          "status": { "type": "string" },
          "count": { "type": "integer" },
          "tokens": { "type": "integer" },
          "tool_uses": { "type": "integer" }
        }
      }
    },
    "files": {
      "type": "object",
      "additionalProperties": false,
      "required": ["written", "edited"],
      "properties": {
        "written": { "type": "array", "items": { "type": "string" } },
        "edited": { "type": "array", "items": { "type": "string" } }
      }
    },
    "plans_touched": { "type": "array", "items": { "type": "string" } },
    "events": {
      "type": "object",
      "additionalProperties": false,
      "required": ["compactions", "api_errors", "local_commands"],
      "properties": {
        "compactions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["trigger", "pre_tokens", "post_tokens"],
            "properties": {
              "trigger": { "type": ["string", "null"] },
              "pre_tokens": { "type": "integer" },
              "post_tokens": { "type": "integer" }
            }
          }
        },
        "api_errors": { "type": "integer" },
        "local_commands": { "type": "integer" }
      }
    },
    "thinking": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["blocks"],
      "properties": {
        "blocks": { "type": "integer" }
      }
    },
    "event_stream": {
      "type": "array",
      "description": "v2.0 ordered timestamped event stream. additionalProperties:false over the union of all per-kind fields is a second line of defense behind serializeEvent's allowlist-by-construction.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["t", "kind"],
        "properties": {
          "t": { "type": "string" },
          "t_precision": { "enum": ["exact", "anchored", "interpolated", "interval"] },
          "kind": {
            "enum": [
              "prompt",
              "turn",
              "tools",
              "skill",
              "flow",
              "flow_log",
              "branch",
              "harness",
              "checks",
              "command_exit",
              "subagent",
              "compaction",
              "model",
              "api_error"
            ]
          },
          "words": { "type": "integer" },
          "dur_s": { "type": "integer" },
          "in": { "type": "integer" },
          "out": { "type": "integer" },
          "cache_read": { "type": "integer" },
          "cache_create": { "type": "integer" },
          "model": { "type": "string" },
          "name": { "type": "string" },
          "count": { "type": "integer" },
          "span_s": { "type": "integer" },
          "status": { "type": "string" },
          "flow": { "type": "string" },
          "stage": { "type": "string" },
          "op": { "type": "string" },
          "node": { "type": "string" },
          "type": { "type": "string" },
          "edge_op": { "type": "string" },
          "from": { "type": "string" },
          "to": { "type": "string" },
          "verb": { "type": "string" },
          "exit": { "type": "integer" },
          "gates": { "type": "object", "additionalProperties": { "type": "string" } },
          "signature": { "type": "string" }
        }
      }
    },
    "rollup": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["activity", "flow_stage_time_s", "skills", "tokens", "tools", "outcomes"],
      "properties": {
        "activity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["wall_s", "agent_working_s", "human_s", "idle_s", "working_ratio"],
          "properties": {
            "wall_s": { "type": "integer" },
            "agent_working_s": { "type": "integer" },
            "human_s": { "type": "integer" },
            "idle_s": { "type": "integer" },
            "working_ratio": { "type": "number" }
          }
        },
        "flow_stage_time_s": { "type": "object", "additionalProperties": { "type": "integer" } },
        "skills": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["runs", "abandoned", "superseded"],
            "properties": {
              "runs": { "type": "integer" },
              "abandoned": { "type": "integer" },
              "superseded": { "type": "integer" }
            }
          }
        },
        "tokens": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["in", "out", "cache_read", "cache_create"],
          "properties": {
            "in": { "type": "integer" },
            "out": { "type": "integer" },
            "cache_read": { "type": "integer" },
            "cache_create": { "type": "integer" }
          }
        },
        "tools": { "type": "object", "additionalProperties": { "type": "integer" } },
        "outcomes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["exits"],
          "properties": {
            "checks": { "type": "string" },
            "exits": { "type": "object", "additionalProperties": { "type": "integer" } }
          }
        }
      }
    }
  }
}
