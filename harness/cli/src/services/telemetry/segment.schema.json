{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ai-substrate.dev/schemas/telemetry/segment-2.7.json",
  "title": "Harness telemetry segment (counts-only)",
  "description": "Normalized, counts-only per-session telemetry record (plan 034). The load-bearing cross-tool/cross-repo contract. NO content fields ever — only allowlisted counts and identifiers; file paths are repo-relative. Capability fields are nullable (null when unimplemented, never estimated). Kept key-set-equal to SEGMENT_FIELD_KEYS by segment-schema.test.ts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "command",
    "harness",
    "harness_version",
    "harness_session_id",
    "timecode",
    "window",
    "branch",
    "tokens",
    "effort",
    "event_stream",
    "rollup"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "2.7" },
    "command": { "type": "string" },
    "harness": { "type": "string" },
    "harness_version": { "type": "string" },
    "harness_session_id": { "type": "string" },
    "timecode": { "type": "string" },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["since", "from", "to"],
      "properties": {
        "since": { "enum": ["session-start", "last-command"] },
        "from": { "type": "integer" },
        "to": { "type": "integer" }
      }
    },
    "branch": { "type": ["string", "null"] },
    "tokens": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": [
        "input",
        "output",
        "cache_create",
        "cache_read",
        "total",
        "subagent_tokens",
        "grand_total"
      ],
      "properties": {
        "input": { "type": "integer" },
        "output": { "type": "integer" },
        "cache_create": { "type": "integer" },
        "cache_read": { "type": "integer" },
        "total": { "type": "integer" },
        "subagent_tokens": { "type": "integer" },
        "grand_total": { "type": "integer" }
      }
    },
    "models": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["turns", "output_tokens"],
        "properties": {
          "turns": { "type": "integer" },
          "output_tokens": { "type": "integer" }
        }
      }
    },
    "effort": { "type": ["string", "null"] },
    "skills": {
      "type": "object",
      "additionalProperties": { "type": "integer" }
    },
    "tools": {
      "type": "object",
      "additionalProperties": { "type": "integer" }
    },
    "user_prompts": { "type": "array", "items": { "type": "integer" } },
    "subagents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["count"],
        "properties": {
          "type": { "type": "string" },
          "agent_name": { "type": "string" },
          "model": { "type": "string" },
          "status": { "type": "string" },
          "count": { "type": "integer" },
          "tokens": { "type": "integer" },
          "tool_uses": { "type": "integer" }
        }
      }
    },
    "files": {
      "type": "object",
      "additionalProperties": false,
      "required": ["written", "edited"],
      "properties": {
        "written": { "type": "array", "items": { "type": "string" } },
        "edited": { "type": "array", "items": { "type": "string" } }
      }
    },
    "plans_touched": { "type": "array", "items": { "type": "string" } },
    "events": {
      "type": "object",
      "additionalProperties": false,
      "required": ["compactions", "api_errors", "local_commands"],
      "properties": {
        "compactions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["trigger", "pre_tokens", "post_tokens"],
            "properties": {
              "trigger": { "type": ["string", "null"] },
              "pre_tokens": { "type": "integer" },
              "post_tokens": { "type": "integer" }
            }
          }
        },
        "api_errors": { "type": "integer" },
        "local_commands": { "type": "integer" }
      }
    },
    "thinking": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["blocks"],
      "properties": {
        "blocks": { "type": "integer" }
      }
    },
    "captured_env": {
      "type": "object",
      "description": "v2.5 — finite pij environment snapshot. Exactly eight current keys, each with a context-specific identifier/enum/model grammar. Unknown, legacy-only, content, SPAWN_TASK, and credential-shaped values are excluded before serialization.",
      "additionalProperties": false,
      "properties": {
        "PIJ_SESSION_ID": { "type": "string", "pattern": "^pij-[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$" },
        "PIJ_PARENT_ID": { "type": "string", "pattern": "^pij-[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$" },
        "PIJ_HARNESS": { "enum": ["pi", "pij", "claude", "claude-code", "copilot", "copilot-cli", "copilot-vscode", "cursor", "cursor-agent", "minih"] },
        "PIJ_ROLE": { "enum": ["coder", "reviewer", "orchestrator", "worker", "parent", "child", "planner", "researcher", "validator", "implementer", "lead", "peer", "context-owner"] },
        "PIJ_ANNOUNCE_TO": { "type": "string", "pattern": "^pij-[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$" },
        "PIJ_SPAWN_ID": { "type": "string", "pattern": "^spawn-[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$" },
        "PIJ_SPAWN_MODEL": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,31}/[A-Za-z0-9]+(?:[._-][A-Za-z0-9]+){1,15}(?::(?:off|minimal|low|medium|high|xhigh))?$" },
        "PIJ_SPAWN_EFFORT": { "enum": ["off", "minimal", "low", "medium", "high", "xhigh"] }
      }
    },
    "product_commit": {
      "type": "string",
      "description": "v2.5 — optional lowercase full product HEAD OID observed during this activity window.",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "capture_mode": {
      "type": "string",
      "description": "v2.7 — OMITTED for a normal in-session capture. 'reconciled' marks a LATE segment recovered from an orphaned lane after the session stopped running harness commands: its timecode is the recovery time and its event instants are interval-grade.",
      "const": "reconciled"
    },
    "event_stream": {
      "type": "array",
      "description": "v2.0 ordered timestamped event stream. additionalProperties:false over the union of all per-kind fields is a second line of defense behind serializeEvent's allowlist-by-construction.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["t", "kind"],
        "properties": {
          "t": { "type": "string" },
          "t_precision": { "enum": ["exact", "anchored", "interpolated", "interval"] },
          "kind": {
            "enum": [
              "prompt",
              "turn",
              "usage",
              "tools",
              "skill",
              "flow",
              "flow_log",
              "branch",
              "harness",
              "checks",
              "command_exit",
              "subagent",
              "compaction",
              "model",
              "api_error",
              "artifact",
              "file",
              "mark"
            ]
          },
          "observation_kind": {
            "type": "string",
            "enum": [
              "message_output",
              "cumulative_checkpoint",
              "partial_compaction",
              "final_shutdown"
            ]
          },
          "words": { "type": "integer" },
          "dur_s": { "type": "integer" },
          "in": { "type": "integer", "minimum": 0 },
          "out": { "type": "integer", "minimum": 0 },
          "cache_read": { "type": "integer", "minimum": 0 },
          "cache_create": { "type": "integer", "minimum": 0 },
          "nano_aiu": { "type": "integer", "minimum": 0 },
          "model": { "type": "string" },
          "name": { "type": "string" },
          "count": { "type": "integer" },
          "span_s": { "type": "integer" },
          "status": { "type": "string" },
          "flow": { "type": "string" },
          "stage": { "type": "string" },
          "op": { "type": "string" },
          "node": { "type": "string" },
          "type": { "type": "string" },
          "edge_op": { "type": "string" },
          "from": { "type": "string" },
          "to": { "type": "string" },
          "verb": { "type": "string" },
          "observe_kind": {
            "type": "string",
            "description": "plan 056 — a harness `observe` event's observation kind (closed 8-enum, present only when verb=observe; never prose).",
            "enum": [
              "difficulty",
              "magic-wand",
              "gift",
              "insight",
              "coordination",
              "improvement-suggestion",
              "confusion",
              "win"
            ]
          },
          "exit": { "type": "integer" },
          "gates": { "type": "object", "additionalProperties": { "type": "string" } },
          "signature": { "type": "string" },
          "control": {
            "type": "object",
            "description": "plan 069 — a `tools` event's per-signature counts of the CLOSED control-command allowlist run anywhere in the burst's command lines. The chain-HEAD `signature` drops these (a `cd repo && git push` reads `cd`), and they are what the report's `bash` control-timeline markers are built from.",
            "propertyNames": { "enum": ["git push", "git commit"] },
            "additionalProperties": { "type": "integer", "minimum": 1 }
          },
          "arg": { "type": "string" },
          "result_tokens": { "type": "integer" },
          "path": { "type": "string" },
          "artifact_type": {
            "enum": [
              "review",
              "plan",
              "workshop",
              "dossier",
              "tasks",
              "execution-log",
              "backpressure",
              "validation",
              "ship-report",
              "flight-plan",
              "retro"
            ]
          },
          "plan_id": { "type": "string" },
          "mark_kind": { "type": "string", "description": "plan 053 — a `mark` event's category slug (shape-guarded `^[a-z][a-z0-9-]{0,31}$`, never prose)." },
          "verdict": { "type": "string", "description": "plan 053 — a `mark` event's optional verdict slug (same shape guard; distinct from the artifact `enums.verdict` vocabulary)." },
          "change": { "enum": ["written", "edited"] },
          "delta": {
            "type": "object",
            "additionalProperties": false,
            "description": "plan 056 — a `file` event's integer line/byte add+remove counts, computed from the tool payload (never the file text).",
            "required": ["lines_added", "lines_removed", "bytes_added", "bytes_removed"],
            "properties": {
              "lines_added": { "type": "integer" },
              "lines_removed": { "type": "integer" },
              "bytes_added": { "type": "integer" },
              "bytes_removed": { "type": "integer" }
            }
          },
          "counts": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "absent": { "type": "integer" },
              "blocked": { "type": "integer" },
              "buildable": { "type": "integer" },
              "checks_green": { "type": "integer" },
              "checks_total": { "type": "integer" },
              "chores": { "type": "integer" },
              "chores_done": { "type": "integer" },
              "chores_skipped": { "type": "integer" },
              "chores_todo": { "type": "integer" },
              "comments": { "type": "integer" },
              "cs": { "type": "integer" },
              "decisions": { "type": "integer" },
              "deferred": { "type": "integer" },
              "deviations": { "type": "integer" },
              "disp_command": { "type": "integer" },
              "disp_declined": { "type": "integer" },
              "disp_deferred": { "type": "integer" },
              "disp_diffs": { "type": "integer" },
              "disp_fixed_now": { "type": "integer" },
              "disp_kept": { "type": "integer" },
              "disp_plan": { "type": "integer" },
              "disp_task": { "type": "integer" },
              "done": { "type": "integer" },
              "entries": { "type": "integer" },
              "events": { "type": "integer" },
              "exists": { "type": "integer" },
              "findings": { "type": "integer" },
              "findings_critical": { "type": "integer" },
              "findings_high": { "type": "integer" },
              "findings_low": { "type": "integer" },
              "findings_med": { "type": "integer" },
              "fixes": { "type": "integer" },
              "gaps": { "type": "integer" },
              "gate_fail": { "type": "integer" },
              "gate_na": { "type": "integer" },
              "gate_pass": { "type": "integer" },
              "high": { "type": "integer" },
              "in_progress": { "type": "integer" },
              "kind_confusion": { "type": "integer" },
              "kind_coordination": { "type": "integer" },
              "kind_difficulty": { "type": "integer" },
              "kind_gift": { "type": "integer" },
              "kind_improvement_suggestion": { "type": "integer" },
              "kind_insight": { "type": "integer" },
              "kind_magic_wand": { "type": "integer" },
              "kind_win": { "type": "integer" },
              "nodes": { "type": "integer" },
              "observations": { "type": "integer" },
              "open": { "type": "integer" },
              "phases": { "type": "integer" },
              "pr_opened": { "type": "integer" },
              "re_reviews": { "type": "integer" },
              "resolved": { "type": "integer" },
              "sections": { "type": "integer" },
              "skipped": { "type": "integer" },
              "todo": { "type": "integer" },
              "workshop_opps": { "type": "integer" },
              "workshops": { "type": "integer" }
            }
          },
          "enums": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "verdict": {
                "type": "string",
                "enum": [
                  "APPROVE",
                  "APPROVE_WITH_NOTES",
                  "FIX_REQUIRED",
                  "NEEDS_ATTENTION",
                  "VALIDATED",
                  "VALIDATED_WITH_FIXES",
                  "other"
                ]
              },
              "mode": { "type": "string", "enum": ["SIMPLE", "FULL", "other"] },
              "status": { "type": "string", "enum": ["READY", "DRAFT", "other"] },
              "target_proof": {
                "type": "string",
                "enum": [
                  "CONTRACT_READY",
                  "PREFERRED_DIRECTION",
                  "DIRECTIONAL",
                  "EXPLORATORY",
                  "other"
                ]
              },
              "current_proof": {
                "type": "string",
                "enum": [
                  "CONTRACT_READY",
                  "PREFERRED_DIRECTION",
                  "DIRECTIONAL",
                  "EXPLORATORY",
                  "other"
                ]
              },
              "certainty": {
                "type": "string",
                "enum": ["FULL", "PARTIAL", "NONE", "COMPLETE", "other"]
              },
              "pr_state": {
                "type": "string",
                "enum": ["OPEN", "MERGED", "CLOSED", "DRAFT", "other"]
              }
            }
          },
          "size": {
            "type": "object",
            "additionalProperties": false,
            "required": ["lines", "bytes"],
            "properties": {
              "lines": { "type": "integer" },
              "bytes": { "type": "integer" }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "required": ["kind"],
              "properties": { "kind": { "const": "usage" } }
            },
            "then": {
              "required": ["observation_kind"],
              "anyOf": [
                { "required": ["in"] },
                { "required": ["out"] },
                { "required": ["cache_read"] },
                { "required": ["cache_create"] },
                { "required": ["nano_aiu"] }
              ]
            },
            "else": {
              "not": {
                "anyOf": [
                  { "required": ["observation_kind"] },
                  { "required": ["nano_aiu"] }
                ]
              }
            }
          }
        ]
      }
    },
    "rollup": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["activity", "flow_stage_time_s", "skills", "tokens", "tools", "outcomes"],
      "properties": {
        "activity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["wall_s", "agent_working_s", "human_s", "idle_s", "working_ratio"],
          "properties": {
            "wall_s": { "type": "integer" },
            "agent_working_s": { "type": "integer" },
            "human_s": { "type": "integer" },
            "idle_s": { "type": "integer" },
            "working_ratio": { "type": "number" }
          }
        },
        "flow_stage_time_s": { "type": "object", "additionalProperties": { "type": "integer" } },
        "skills": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["runs", "abandoned", "superseded"],
            "properties": {
              "runs": { "type": "integer" },
              "abandoned": { "type": "integer" },
              "superseded": { "type": "integer" }
            }
          }
        },
        "tokens": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["in", "out", "cache_read", "cache_create"],
          "properties": {
            "in": { "type": "integer" },
            "out": { "type": "integer" },
            "cache_read": { "type": "integer" },
            "cache_create": { "type": "integer" }
          }
        },
        "tools": { "type": "object", "additionalProperties": { "type": "integer" } },
        "outcomes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["exits"],
          "properties": {
            "checks": { "type": "string" },
            "exits": { "type": "object", "additionalProperties": { "type": "integer" } }
          }
        }
      }
    }
  }
}
