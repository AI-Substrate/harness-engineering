{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/AI-Substrate/harness-engineering/schemas/telemetry/session-export/v1",
  "title": "SessionExport",
  "description": "A thin, validatable envelope wrapping one coding session's combined OTel telemetry (plan 047 Phase 1). Still OTel: `signals.logs`/`signals.metrics` are OTLP payloads regenerated FORWARD from the session's segments (Logs are the lossless substrate; metrics are derived, never inverted). Additive: additionalProperties:true + a pinned schema_version so a future report/RunRecord consumer never breaks on a new field.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "identity",
    "source",
    "summary",
    "signals"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "harness.session-export/v1",
      "description": "Pinned envelope version. Bump on a field-set change."
    },
    "identity": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "harness_session_id",
        "harness",
        "harness_version",
        "pij_session_id",
        "branch",
        "models"
      ],
      "properties": {
        "harness_session_id": {
          "type": "string",
          "description": "Opaque per-session correlation handle \u2014 NOT an individual identity (AC-11)."
        },
        "harness": {
          "type": "string",
          "description": "The producing harness (claude-code | copilot-cli | cursor | \u2026)."
        },
        "harness_version": {
          "type": [
            "string",
            "null"
          ],
          "description": "The producing CLI version, or null when a segment omitted it."
        },
        "pij_session_id": {
          "type": [
            "string",
            "null"
          ],
          "description": "captured_env.PIJ_SESSION_ID join key when present, else null."
        },
        "branch": {
          "type": [
            "string",
            "null"
          ],
          "description": "The git branch at capture, or null."
        },
        "models": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Distinct model names seen across the session, first-seen order."
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "kind",
        "root",
        "segment_count"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "temp",
            "git-ref"
          ],
          "description": "Where the segments were read from. Phase 1 = temp; git-ref is Phase 3."
        },
        "root": {
          "type": "string",
          "description": "The buffer location, repo-relative or a basename (never an absolute /Users/\u2026 path \u2014 P12)."
        },
        "segment_count": {
          "type": "integer",
          "minimum": 0,
          "description": "How many segments were combined into this export."
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "segment_schema_versions",
        "first_timecode",
        "last_timecode",
        "tokens",
        "degraded"
      ],
      "properties": {
        "segment_schema_versions": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          },
          "description": "Histogram of the schema_version of each combined segment (e.g. {\"2.0\": 40, \"1.1\": 3}) \u2014 records exactly what went in, including v1 (no-event_stream) segments (AC-02)."
        },
        "first_timecode": {
          "type": [
            "string",
            "null"
          ],
          "description": "Earliest segment timecode, or null when none."
        },
        "last_timecode": {
          "type": [
            "string",
            "null"
          ],
          "description": "Latest segment timecode, or null when none."
        },
        "tokens": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "in",
            "out",
            "cache_read",
            "cache_create",
            "total",
            "subagent_tokens",
            "grand_total"
          ],
          "description": "Session token totals. `subagent_tokens`/`grand_total` are \"unknown\" (a string) \u2014 NEVER 0 \u2014 when any segment's subagent tokens were unknown (AC-10).",
          "properties": {
            "in": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "out": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "cache_read": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "cache_create": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "total": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "subagent_tokens": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "string",
                  "const": "unknown"
                }
              ]
            },
            "grand_total": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "string",
                  "const": "unknown"
                }
              ]
            }
          }
        },
        "degraded": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Field names that were absent / unknown across the session (e.g. \"subagent_tokens\", \"plans_touched\", \"v1_segments\") \u2014 surfaced honestly, never faked (AC-10)."
        },
        "token_evidence": {
          "$ref": "#/$defs/tokenEvidence"
        }
      }
    },
    "signals": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "logs",
        "metrics"
      ],
      "description": "The combined OTel payloads. `logs` is the lossless substrate (one merged ResourceLogs, all events ordered by harness.event.t); `metrics` is derived FORWARD from the session rollup (one ResourceMetrics) \u2014 never inverted, never a sum of per-command cumulative metrics.",
      "properties": {
        "logs": {
          "type": "object",
          "additionalProperties": true,
          "description": "OTLP LogsData \u2014 one merged resourceLogs."
        },
        "metrics": {
          "type": "object",
          "additionalProperties": true,
          "description": "OTLP MetricsData \u2014 one session-level resourceMetrics regenerated from computeRollup(all events)."
        }
      }
    }
  },
  "$defs": {
    "tokenFieldEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "source",
        "observation_kind",
        "coverage",
        "reason"
      ],
      "properties": {
        "value": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "source": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "live",
            "ref",
            "ledger",
            null
          ]
        },
        "observation_kind": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "message_output",
            "cumulative_checkpoint",
            "partial_compaction",
            "final_shutdown",
            "session_total",
            null
          ]
        },
        "coverage": {
          "type": "string",
          "enum": [
            "measured",
            "unavailable"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "no_observation",
            "field_absent",
            "partial_observation",
            "identity_unavailable",
            "source_unavailable",
            "flushed_segments_unreadable",
            "post_checkpoint_tail",
            "mixed_observation_kinds",
            "vendor_field_absent",
            "transcript_zero",
            "transcript_multiple",
            "transcript_unresolved",
            "transcript_traversal",
            "transcript_symlink",
            "transcript_non_file",
            "transcript_oversize",
            "transcript_malformed",
            "transcript_ambiguity",
            null
          ]
        }
      }
    },
    "tokenEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coverage",
        "reason",
        "cause",
        "source",
        "fields"
      ],
      "properties": {
        "coverage": {
          "type": "string",
          "enum": [
            "measured",
            "partial",
            "unavailable"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "no_observation",
            "field_absent",
            "partial_observation",
            "identity_unavailable",
            "source_unavailable",
            "flushed_segments_unreadable",
            "post_checkpoint_tail",
            "mixed_observation_kinds",
            "vendor_field_absent",
            "transcript_zero",
            "transcript_multiple",
            "transcript_unresolved",
            "transcript_traversal",
            "transcript_symlink",
            "transcript_non_file",
            "transcript_oversize",
            "transcript_malformed",
            "transcript_ambiguity",
            null
          ]
        },
        "cause": {
          "const": "unknown"
        },
        "source": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "live",
            "ref",
            "ledger",
            null
          ]
        },
        "fields": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "input",
            "output",
            "cache_read",
            "cache_create",
            "nano_aiu"
          ],
          "properties": {
            "input": {
              "$ref": "#/$defs/tokenFieldEvidence"
            },
            "output": {
              "$ref": "#/$defs/tokenFieldEvidence"
            },
            "cache_read": {
              "$ref": "#/$defs/tokenFieldEvidence"
            },
            "cache_create": {
              "$ref": "#/$defs/tokenFieldEvidence"
            },
            "nano_aiu": {
              "$ref": "#/$defs/tokenFieldEvidence"
            }
          }
        }
      }
    }
  }
}
