{
  "dd_schema": 1,
  "description": "A builder plan: goals, acceptance criteria, phases, tasks, and one evidence list per task.",
  "enums": {
    "plan_status": {
      "values": [
        "draft",
        "ready",
        "in-progress",
        "shipped",
        "abandoned"
      ]
    },
    "complexity": {
      "values": [
        "CS-1",
        "CS-2",
        "CS-3",
        "CS-4",
        "CS-5"
      ]
    }
  },
  "sections": {
    "meta": {
      "required": true,
      "shape": {
        "type": "object",
        "required": [
          "title",
          "status"
        ],
        "fields": {
          "title": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "ordinal": {
            "type": "int"
          },
          "status": {
            "type": "enum",
            "enum": "plan_status"
          },
          "complexity": {
            "type": "enum",
            "enum": "complexity"
          },
          "summary": {
            "type": "text"
          },
          "backpressure": {
            "type": "link",
            "target": "builder/backpressure/section/rows"
          },
          "log": {
            "type": "link",
            "target": "builder/execution-log/section/entries"
          }
        }
      }
    },
    "goals": {
      "shape": {
        "type": "array",
        "items": {
          "type": "text"
        }
      }
    },
    "non_goals": {
      "title": "Non-goals",
      "shape": {
        "type": "array",
        "items": {
          "type": "text"
        }
      }
    },
    "acceptance_criteria": {
      "shape": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "id",
            "claim",
            "state"
          ],
          "fields": {
            "id": {
              "type": "string"
            },
            "claim": {
              "type": "text"
            },
            "state": {
              "type": "state"
            },
            "note": {
              "type": "string"
            },
            "receipt": {
              "type": "string"
            },
            "pressure": {
              "type": "link",
              "target": "builder/backpressure/section/rows"
            },
            "proven_by": {
              "type": "link",
              "target": "builder/execution-log/section/entries"
            }
          }
        }
      }
    },
    "phases": {
      "shape": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "id",
            "title",
            "state"
          ],
          "fields": {
            "id": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "brief": {
              "type": "text"
            },
            "state": {
              "type": "state"
            },
            "note": {
              "type": "string"
            },
            "receipt": {
              "type": "string"
            },
            "depends_on": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "tasks": {
              "type": "link"
            }
          }
        }
      }
    },
    "tasks": {
      "shape": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "id",
            "title",
            "state"
          ],
          "fields": {
            "id": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "domain": {
              "type": "string"
            },
            "phase": {
              "type": "string"
            },
            "state": {
              "type": "state"
            },
            "note": {
              "type": "string"
            },
            "receipt": {
              "type": "string"
            },
            "done": {
              "type": "link",
              "target": "builder/plan/section/evidence"
            }
          }
        }
      }
    },
    "evidence": {
      "shape": {
        "type": "object",
        "allowAdditional": true,
        "fields": {},
        "valuesShape": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "assertion",
              "state"
            ],
            "fields": {
              "id": {
                "type": "string"
              },
              "assertion": {
                "type": "text"
              },
              "state": {
                "type": "state"
              },
              "note": {
                "type": "string"
              },
              "receipt": {
                "type": "string"
              },
              "proven_by": {
                "type": "link",
                "target": "builder/execution-log/section/entries"
              },
              "pressure": {
                "type": "link",
                "target": "builder/backpressure/section/rows"
              }
            }
          }
        }
      }
    }
  }
}
