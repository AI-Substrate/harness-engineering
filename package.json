{
  "name": "@ai-substrate/engineering-harness",
  "version": "0.6.0",
  "description": "Starter Harness CLI Core — the agent-friendly front door to this repo's engineering harness.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AI-Substrate/harness-engineering.git"
  },
  "bin": {
    "harness": "./harness/cli/bin/harness.js",
    "engh": "./harness/cli/bin/harness.js"
  },
  "exports": {
    ".": "./harness/cli/dist/index.js",
    "./contract": {
      "types": "./harness/cli/dist/services/extensions/contract.d.ts",
      "import": "./harness/cli/dist/services/extensions/contract.js",
      "default": "./harness/cli/dist/services/extensions/contract.js"
    }
  },
  "files": [
    "harness/cli/bin",
    "harness/cli/dist",
    "LICENSE"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "gen:docs": "node scripts/gen-docs.mjs",
    "gen:flows": "node scripts/gen-flows.mjs",
    "gen:flow-fixtures": "node scripts/flow-fixtures.mjs",
    "gen:telemetry-fixtures": "node scripts/telemetry-fixtures.mjs",
    "check:docs": "npm run gen:docs && git diff --exit-code harness/cli/src/services/docs/docs-content.ts",
    "check:flows": "npm run gen:flows && git diff --exit-code harness/cli/src/services/flow/schemas-content.ts && node scripts/flow-fixtures.mjs --check",
    "check:telemetry-fixtures": "node scripts/telemetry-fixtures.mjs --check",
    "check:doctrine-parity": "node scripts/doctrine-parity.mjs --check",
    "build": "npm run gen:docs && npm run gen:flows && tsc -p harness/cli/tsconfig.json",
    "prepare": "npm run build",
    "test": "cd harness/cli && vitest run --coverage",
    "lint": "biome check harness/cli",
    "lint:md": "node harness/cli/bin/harness.js markdown-lint",
    "format": "biome format --write harness/cli",
    "fix": "biome check --write harness/cli"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "jiti": "2.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@types/node": "^25",
    "@vitest/coverage-v8": "^4.1.8",
    "dependency-cruiser": "^17.4.3",
    "jsdom": "^29.1.1",
    "markdownlint-cli2": "^0.22.1",
    "mermaid": "^11.15.0",
    "protobufjs": "^8.6.5",
    "remark-cli": "^12.0.1",
    "remark-validate-links": "^13.1.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
